if SHIELD_CHOCOFI_CENTRAL_DONGLE || SHIELD_CHOCOFI_CENTRAL_DONGLE_128X64 || SHIELD_CHOCOFI_CENTRAL_DONGLE_128X32 || SHIELD_CHOCOFI_CENTRAL_LEFT || SHIELD_CHOCOFI_PERIPHERAL_LEFT || SHIELD_CHOCOFI_PERIPHERAL_RIGHT
